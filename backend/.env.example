# Google OAuth (required for Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Gemini API (at least one key required)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODELS=gemini-2.5-flash

# OpenAI (optional fallback)
OPENAI_API_KEY=

# Qwen API 1 (primary)
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODELS=qwen3.7-plus

# Qwen API 2 (secondary, for processing agent)
QWEN2_API_KEY=
QWEN2_BASE_URL=
QWEN2_MODELS=

# General
AI_FALLBACK_ENABLED=true
PORT=3001
# Optional legacy defaults — once a user connects Gmail, sender name/email come from their account
SENDER_EMAIL=
SENDER_NAME=
FRONTEND_URL=http://localhost:5173
